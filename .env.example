MINIMAX_API_KEY=your-api-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5

# Optional: LangSmith tracing (https://smith.langchain.com)
# Sign up at https://smith.langchain.com and create an API key.
# When set, all pipeline nodes and LLM calls are traced automatically.
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=xiv-timeline-generator

# FFLogs API v2 (https://www.fflogs.com/api/clients/)
# FFLOGS_CLIENT_ID=your-client-id
# FFLOGS_CLIENT_SECRET=your-client-secret
